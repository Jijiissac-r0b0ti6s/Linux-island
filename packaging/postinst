#!/bin/sh
set -e
# byte-compile for whichever Python this system has (the bundle itself is version-independent)
if [ "$1" = configure ]; then
    for py in python3 python3.15 python3.14 python3.13 python3.12 python3.11 python3.10; do
        if command -v "$py" >/dev/null 2>&1; then
            "$py" -m compileall -q /opt/linux-island/lib >/dev/null 2>&1 || true
            break
        fi
    done
fi
exit 0
